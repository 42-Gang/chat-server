{
  "request": {
    "method": "GET",
    "urlPath": "/api/v1/users/1",
    "headers": {
      "X-Authenticated": {
        "equalTo": "true"
      },
      "X-User-Id": {
        "equalTo": "1"
      }
    }
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "data": {
        "nickname": "john_doe",
        "avatar": "https://example.com/avatar/8.png"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
